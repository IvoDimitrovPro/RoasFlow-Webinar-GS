# Authentication - Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Video Streaming - Stream.io
NEXT_PUBLIC_STREAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxx
STREAM_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxx

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Analytics and Monitoring (Uncomment when adding)
# NEXT_PUBLIC_ANALYTICS_ID=
# NEXT_PUBLIC_SENTRY_DSN=

# Database (Uncomment when adding)
# DATABASE_URL=

# Security (Uncomment when adding)
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000

# Feature Flags (Uncomment when adding)
# NEXT_PUBLIC_ENABLE_RECORDINGS=true
# NEXT_PUBLIC_ENABLE_WEBINAR_MODE=true
